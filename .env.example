# Shared secret every caller must present as x-api-key or Authorization: Bearer.
# In n8n this goes in the API Key field of the Anthropic credential.
RELAY_API_KEY=change-me

# Claude subscription credentials for the Agent SDK. Generate on a machine that
# is logged into Claude Code:  claude setup-token
# Leave unset if you mount a logged-in ~/.claude instead.
CLAUDE_CODE_OAUTH_TOKEN=

# --- optional ---------------------------------------------------------------
# PORT=8787
# RELAY_HOST=0.0.0.0
# RELAY_DEFAULT_MODEL=claude-sonnet-5
# How long a session waits for a tool result before it is abandoned.
# RELAY_SESSION_TTL_MS=600000
# RELAY_MAX_SESSIONS=32
# RELAY_TOOL_TIMEOUT_MS=900000
# Working directory for the agent process. Only matters for tool-enabled aliases.
# RELAY_CWD=/workspace
# Extra model aliases, as JSON: alias -> { model, tools[], effort }
# RELAY_MODELS={"fast":{"model":"claude-haiku-4-5","tools":[],"effort":"low"}}
# Run with no shared secret. Only for a network nobody else can reach.
# RELAY_ALLOW_ANONYMOUS=1
# Prompt cache TTL, "1h" or "5m". 1h keeps the cache warm between n8n runs;
# on API-key billing 1h cache writes cost more.
# RELAY_CACHE_TTL=1h
